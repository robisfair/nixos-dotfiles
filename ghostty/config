theme = Catppuccin Mocha
font-family = "JetBrainsMono Nerd Font"
font-size = 12

# Remove internal terminal padding so Neovim fills the edges
window-padding-x = 0
window-padding-y = 0

# Ensures terminal background extends edge-to-edge
window-padding-balance = true

# Transparency & Blur
#background-opacity = 0.85
#background-blur-radius = 20

# Clipboard & Mouse
copy-on-select = true
